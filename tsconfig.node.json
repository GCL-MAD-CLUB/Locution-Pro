{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "scripts/**/*.ts",
    "tooling/**/*.ts",
    "eslint.config.ts",
    "vite.config.ts",
    "tests/unit/**/*.ts",
    "tests/integration/**/*.ts"
  ]
}
