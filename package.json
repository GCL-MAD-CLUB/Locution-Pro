{
  "name": "locution-pro",
  "private": true,
  "version": "0.4.3",
  "description": "Media management, visual search, shot organization, and clip delivery",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GCL-MAD-CLUB/Locution-Pro.git"
  },
  "bugs": {
    "url": "https://github.com/GCL-MAD-CLUB/Locution-Pro/issues"
  },
  "homepage": "https://github.com/GCL-MAD-CLUB/Locution-Pro#readme",
  "type": "module",
  "packageManager": "npm@11.7.0",
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=11.7.0"
  },
  "scripts": {
    "test": "npm run test:types && npm run test:coverage",
    "test:installer": "node --test tests/integration/installer/components.test.ts",
    "test:installer-identity": "node --test tests/integration/installer/identity.test.ts",
    "test:installer-maintenance": "node --test tests/integration/installer/maintenance.test.ts",
    "test:installer-safety": "node --test tests/integration/installer/safety.test.ts",
    "test:installer-media": "node --test tests/integration/installer/media-tools.test.ts",
    "check:layout": "node scripts/check-repository-layout.ts",
    "check:site": "node scripts/check-site.ts",
    "dev": "vite --host 127.0.0.1 --port 1420",
    "site:dev": "vite site --host 127.0.0.1 --port 1422 --strictPort",
    "site:build": "tsc --project site/tsconfig.json && node scripts/build-site.ts",
    "site:preview": "npm run site:build && vite dist/site --host 127.0.0.1 --port 1422 --strictPort",
    "docs:check": "node scripts/check-user-guide.ts",
    "docs:dev": "vitepress dev docs/user-guide",
    "docs:build": "npm run docs:check && vitepress build docs/user-guide",
    "docs:preview": "vitepress preview docs/user-guide",
    "build": "npm run check:errors && npm run check:architecture && npm run check:media-sources && tsc && vite build",
    "build:thumbnail-provider": "node scripts/build-thumbnail-provider.ts",
    "prepare:transnetv2": "node scripts/prepare-transnetv2-assets.ts",
    "prepare:ffmpeg": "node scripts/prepare-ffmpeg-assets.ts",
    "prepare:installer": "node scripts/prepare-installer-manifest.ts",
    "build:update-installer": "node scripts/build-update-installer.ts",
    "prepare:release": "node scripts/prepare-release-manifest.ts",
    "check:release": "node scripts/check-release-assets.ts",
    "release:draft": "node scripts/prepare-release-draft.ts",
    "check:errors": "node scripts/check-error-boundaries.ts",
    "check:architecture": "node scripts/check-system-architecture.ts",
    "deps:frontend": "node scripts/check-system-architecture.ts --json",
    "check:media-sources": "node scripts/check-media-sources.ts",
    "check:versions": "node scripts/check-version-consistency.ts",
    "check": "npm run format:frontend:check && npm run lint && npm run check:layout && npm test && npm run check:versions && npm run build && npm run site:build && npm run docs:build",
    "format": "prettier --write . && npm run format:rust",
    "format:frontend:check": "prettier --check .",
    "format:check": "npm run format:frontend:check && npm run format:rust:check",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml && cargo fmt --manifest-path src-tauri/thumbnail-provider/Cargo.toml",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo fmt --manifest-path src-tauri/thumbnail-provider/Cargo.toml -- --check",
    "preview": "vite preview --host 127.0.0.1 --port 1421",
    "release:build": "node scripts/release.ts",
    "tauri": "tauri",
    "prepare:semantic": "node scripts/prepare-semantic-assets.ts",
    "prepare:storyboard-semantic": "node scripts/prepare-storyboard-semantic-assets.ts",
    "test:e2e": "npm run test:browser",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm test && npm run test:browser",
    "test:types": "tsc --project tests/tsconfig.json && tsc --project tsconfig.node.json && tsc --project site/tsconfig.json",
    "test:coverage": "c8 npm run test:unit && c8 check-coverage --include \"src/core/**/*.ts\" --lines 74 --statements 74 --functions 70 --branches 88",
    "test:unit": "node --test --test-concurrency=4 --test-timeout=45000 --test-reporter=spec \"tests/unit/**/*.test.ts\"",
    "test:browser": "playwright test",
    "test:browser:workflows": "playwright test tests/browser/workflows",
    "test:browser:components": "playwright test tests/browser/components",
    "test:browser:state": "playwright test tests/browser/state",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "test:rust:thumbnail": "cargo test --manifest-path src-tauri/thumbnail-provider/Cargo.toml --locked",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "d3-force": "^3.0.1",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rxjs": "^7.8.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/utils": "^8.73.0",
    "@vitejs/plugin-react": "^6.3.0",
    "c8": "^12.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitepress": "^1.6.4"
  },
  "overrides": {
    "vitepress": {
      "vite": "^6.4.5"
    }
  }
}
